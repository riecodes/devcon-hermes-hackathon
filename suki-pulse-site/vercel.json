{
  "cleanUrls": true,
  "redirects": [
    { "source": "/(.*)", "has": [{ "type": "host", "value": "jev-live-race.vercel.app" }], "destination": "https://suki-pulse.vercel.app/race/", "permanent": false },
    { "source": "/(.*)", "has": [{ "type": "host", "value": "jev-decision-race.vercel.app" }], "destination": "https://suki-pulse.vercel.app/benchmark/", "permanent": false }
  ],
  "functions": {
    "api/race.js": { "maxDuration": 30 },
    "api/batch.js": { "maxDuration": 60 },
    "api/scale.js": { "maxDuration": 25 },
    "api/check.js": { "maxDuration": 10 },
    "api/sample.js": { "maxDuration": 10 }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
